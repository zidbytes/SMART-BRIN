{
  "version": 2,
  "framework": null,
  "builds": [
    {
      "src": "resources/js/app.tsx",
      "use": "@vercel/node",
      "config": {
        "maxLambdaSize": "15mb",
        "compiler": "vite",
        "project": "vite.config.ts"
      }
    }
  ],
  "routes": [
    { "src": "/build/(.*)", "dest": "/public/build/$1" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
